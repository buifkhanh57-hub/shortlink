# Shortlink — Apache configuration
#
# Place this file inside public/ (AllowOverride must permit it).
# All requests that do not map to an existing file are routed to the
# front controller public/index.php.

# Do not list directory contents.
Options -Indexes

# Block dotfiles (.ht*, .git, ...) from the web.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files and directories directly (assets, favicon, …).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Never serve source/storage files if the docroot is misconfigured.
    RewriteRule ^(src|bin|config|tests|data)/ - [F,L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Redirect answers must never be cached by intermediaries.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/json
</IfModule>
